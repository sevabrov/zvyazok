# --- Payment (WayForPay) ------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# WayForPay payment link / button URL (pre-signed, fixed price) generated in
# the WayForPay merchant panel. After payment the user is sent back to
# `<app>/?payment=success`, which unlocks the game on this device.
VITE_WAYFORPAY_PAYMENT_URL=https://secure.wayforpay.com/button/YOUR_BUTTON_ID

# Optional: price label shown on the paywall (purely cosmetic).
VITE_PAYMENT_PRICE_LABEL=99 ₴
